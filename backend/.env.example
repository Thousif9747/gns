DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=gns_db
DB_USER=gns_user
DB_PASSWORD=gns_pass
DB_HOST=postgres
DB_PORT=5432

REDIS_URL=redis://redis:6379/0

# Development/testing only. Never enable in production.
TEST_OTP_ENABLED=False

MEDIA_ROOT=/app/media

# Brevo (SendinBlue) SMTP — sign up free at brevo.com, get 300 emails/day
# Leave blank to use console logging (emails print to docker logs)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-brevo-login-email@example.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GNS <noreply@yourdomain.com>

# Android Play Store (Digital Asset Links)
# Generate keystore with: keytool -genkey -v -keystore gns-release.keystore -alias gns -keyalg RSA -keysize 2048 -validity 10000
# Get fingerprint with:  keytool -list -v -keystore gns-release.keystore -storepass android | findstr "SHA256:"
ANDROID_PACKAGE_NAME=com.GrowNest.app
ANDROID_SHA256_FINGERPRINT=

# Join by joaoapps (Android SMS gateway via FCM push relay) — leave blank to log to console in dev
# Install Join from Play Store, get Device ID + API Key at https://joinjoaomgcd.appspot.com/
JOIN_DEVICE_ID=
JOIN_API_KEY=
